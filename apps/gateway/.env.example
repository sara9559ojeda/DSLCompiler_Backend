PORT=4000
HOST=0.0.0.0

# Secret used to sign/verify JWTs. Change this in every real deployment.
JWT_SECRET=change-me-in-production

# `*` allows any origin (dev). In production use a comma-separated list of the
# frontend's origins; `*` inside an entry matches part of a host, e.g.
# https://myapp-*.vercel.app for preview deployments.
CORS_ORIGIN=*

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000

# Internal-network base URLs of the services this gateway proxies to.
COMPILER_SERVICE_URL=http://localhost:4001
AI_SERVICE_URL=http://localhost:4002
PROJECTS_SERVICE_URL=http://localhost:4003
