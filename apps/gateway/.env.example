PORT=4000
HOST=0.0.0.0

# Secret used to sign/verify JWTs. Change this in every real deployment.
JWT_SECRET=change-me-in-production

# Comma-free single origin for dev; restrict to your frontend's real origin in production.
CORS_ORIGIN=*

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Internal-network base URLs of the services this gateway proxies to.
COMPILER_SERVICE_URL=http://localhost:4001
AI_SERVICE_URL=http://localhost:4002
PROJECTS_SERVICE_URL=http://localhost:4003
