# Used by docker-compose.yml only. Each service also has its own
# .env.example for running it standalone with `npm start` outside Docker.
POSTGRES_USER=compiler_img
POSTGRES_PASSWORD=compiler_img
POSTGRES_DB=compiler_img

# Shared by the gateway (verifies) and the projects service (issues) — must match.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# `*` = any origin. Production: comma-separated list; `*` inside an entry matches part of a host.
CORS_ORIGIN=*

# Gateway → compiler transport inside docker-compose: grpc (default) or http.
COMPILER_TRANSPORT=grpc
GRPC_DEADLINE_MS=5000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Stricter limit for /api/ai/assist (each call can cost tokens)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT_MS=30000
# AI assistant (generate/modify/explain): validation retries, total deadline, max proposal size
ASSIST_MAX_ATTEMPTS=3
ASSIST_DEADLINE_MS=45000
ASSIST_MAX_OUTPUT_CHARS=12000

# Public URL the browser uses to reach the gateway — baked into the web
# build at image build time (Vite env vars are compile-time, not runtime).
PUBLIC_GATEWAY_URL=http://localhost:4000
